---
import Layout from '../layouts/Layout.astro';
import RegistrationMark from '../components/RegistrationMark.astro';
import CropCorners from '../components/CropCorners.astro';
import { getCollection } from 'astro:content';

const featuredWork = (await getCollection('work', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const services = [
  {
    href: '/services/decals',
    color: 'var(--cyan)',
    code: 'C',
    name: 'Decals & Stickers',
    blurb: 'Die-cut vinyl decals and stickers in any shape and size. Designed and cut here.',
  },
  {
    href: '/services/uv',
    color: 'var(--magenta)',
    code: 'M',
    name: 'UV Printing',
    blurb: 'Flat-bed UV on rigid substrates — aluminum, acrylic, PVC foam, wood. Edge to edge.',
  },
  {
    href: '/services/design',
    color: 'var(--yellow)',
    code: 'Y',
    name: 'Design Services',
    blurb: 'Logo, brand identity, and print-ready artwork. Files go to press looking correct.',
  },
];

// Fix 6 — renamed process stages
const steps = [
  { n: 'PREPRESS',   title: 'Tell us what you need', body: 'Fill out the quote form or email us directly. The more detail you give, the faster we turn a quote around.' },
  { n: 'PROOF',      title: 'We send a quote',        body: 'Usually within one business day. You approve the price and artwork before anything runs.' },
  { n: 'PRODUCTION', title: 'Made here',              body: 'Fabricated in-house in Winston-Salem, NC. One person, one shop — no handoffs.' },
  { n: 'DELIVERY',   title: 'Ships or pick up',       body: 'We ship nationwide. Local pickup is available.' },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "OH! Signs LLC",
  "url": "https://ohsigns.shop",
  "email": "hello@ohsigns.shop",
  "description": "Die-cut vinyl decals, UV printing, and brand design. Made in-house in Winston-Salem, NC.",
  "areaServed": "US",
  "priceRange": "$$",
});
---

<Layout
  title="Oh! Signs"
  description="Die-cut vinyl decals, UV printing, and brand design. Made in-house in Winston-Salem, NC."
  sheet="01/11"
>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />

  <!-- ─── Hero ──────────────────────────────────────────────────────────────── -->
  <section class="hero section-y" aria-labelledby="hero-heading">
    <div class="container hero-inner">

      <div class="hero-content">
        <p class="text-label hero-label">Winston-Salem, NC · Est. 2022</p>

        <!-- Fix 6: off-register — cyan + magenta only, no yellow plate -->
        <!-- Fix 3: new headline "CUT. PRINT. STICK." -->
        <h1 id="hero-heading" class="text-hero hero-heading off-register">
          Cut.<br/>Print.<br/>Stick.
        </h1>

        <!-- Fix 3: confident, self-referential, no comparisons -->
        <p class="hero-body">
          Decals, UV printing, and brand design — designed, printed, and cut
          in-house by one person in Winston-Salem.
        </p>
        <div class="hero-actions">
          <a href="/quote" class="btn-sticker">Get a Quote</a>
          <a href="/sample-pack" class="btn btn-outline">Free Sample Pack</a>
        </div>
      </div>

      <!-- Effect 2: registration marks panel -->
      <div class="hero-register-panel" aria-hidden="true">
        <div class="hrp-inner">
          <RegistrationMark size={40} color="var(--cyan)"    class="hrp-mark hrp-mark-tl" />
          <RegistrationMark size={40} color="var(--magenta)" class="hrp-mark hrp-mark-tr" />
          <RegistrationMark size={40} color="var(--yellow)"  class="hrp-mark hrp-mark-bl" />
          <RegistrationMark size={40} color="var(--paper)"   class="hrp-mark hrp-mark-br" />
          <div class="hrp-center">
            <span class="hrp-logo">Oh<span class="hrp-bang">!</span></span>
            <p class="hrp-sub">Signs</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── Services strip ───────────────────────────────────────────────────── -->
  <section class="services-strip section-paper section-y" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <p class="text-label section-label">What We Do</p>
        <h2 id="services-heading" class="text-h2">Three things.<br/>Done well.</h2>
      </div>
      <div class="services-grid">
        {services.map(({ href, color, code, name, blurb }) => (
          <a href={href} class="service-card" style={`--card-color: ${color}`}>
            <CropCorners color="var(--key)" gap={8} size={12} weight={1} />
            <div class="service-card-header">
              <span class="service-code text-mono" style={`background:${color}; color: var(--key)`}>{code}</span>
            </div>
            <h3 class="text-h3 service-card-name">{name}</h3>
            <p class="service-card-blurb">{blurb}</p>
            <span class="service-card-link">Learn more →</span>
          </a>
        ))}
      </div>
      <div class="services-cta">
        <a href="/services" class="btn-sticker btn-sticker-paper">Browse all services</a>
      </div>
    </div>
  </section>

  <!-- ─── Sample pack feature ──────────────────────────────────────────────── -->
  <section class="sample-feature section-y" aria-labelledby="sample-heading">
    <div class="container sample-feature-inner">

      <!-- Effect 4: cut-path card -->
      <div class="cut-path-card" aria-hidden="true">
        <CropCorners color="var(--yellow)" gap={10} size={14} weight={1} />
        <div class="cut-path-inner">
          <p class="cut-path-label text-mono">4 × 5.25 in</p>
          <p class="cut-path-big">Free.</p>
          <p class="cut-path-sub text-mono">Seven<br/>printed<br/>pieces.</p>
        </div>
      </div>

      <!-- Fix 4: rewritten sample pack copy -->
      <div class="sample-feature-content">
        <p class="text-label" style="color: var(--smoke);">See the work before you order</p>
        <h2 id="sample-heading" class="text-h2">We'll send you a free sample pack.</h2>
        <p class="sample-body">
          A 4×5.25" rigid mailer with seven finished printed pieces from our shop —
          actual output, not swatches. Decals, UV prints, different substrates and finishes,
          all produced here. See what the work looks like before you commit to anything.
        </p>
        <a href="/sample-pack" class="btn-sticker">Request a Free Sample Pack</a>
      </div>
    </div>
  </section>

  <!-- ─── Work gallery teaser ──────────────────────────────────────────────── -->
  <section class="gallery-teaser section-paper section-y" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header">
        <p class="text-label section-label" style="color: #5c5c5c;">Our Work</p>
        <h2 id="work-heading" class="text-h2">Recent projects.</h2>
      </div>
      <div class="gallery-grid">
        {featuredWork.map((entry) => (
          <a href={`/work/${entry.slug}`} class="gallery-card">
            <div class="gallery-card-img-wrap">
              <CropCorners color="var(--key)" gap={8} size={10} weight={1} />
              <img
                src={entry.data.image}
                alt={entry.data.imageAlt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <div class="gallery-card-overlay">
                <span class="gallery-card-category text-mono">{entry.data.category}</span>
              </div>
            </div>
            <div class="gallery-card-body">
              <h3 class="gallery-card-title">{entry.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="gallery-cta">
        <a href="/work" class="btn-sticker btn-sticker-paper">See all work</a>
      </div>
    </div>
  </section>

  <!-- ─── How it works ─────────────────────────────────────────────────────── -->
  <!-- Fix 6: PREPRESS → PROOF → PRODUCTION → DELIVERY -->
  <section class="how-it-works section-y" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-header">
        <p class="text-label" style="color: var(--smoke);">The Process</p>
        <h2 id="how-heading" class="text-h2">How it works.</h2>
      </div>
      <div class="steps-grid">
        {steps.map(({ n, title, body }) => (
          <div class="step">
            <span class="step-stage text-mono" aria-label={n}>{n}</span>
            <h3 class="text-h3 step-title">{title}</h3>
            <p class="step-body">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA band ─────────────────────────────────────────────────────────── -->
  <section class="cta-band section-paper">
    <div class="container cta-band-inner">
      <div class="cta-crop-box">
        <CropCorners color="var(--key)" gap={12} size={16} weight={1} />
        <div class="cta-content">
          <h2 class="text-h2 cta-heading">Ready to make something?</h2>
          <p class="cta-body">
            Send us what you have. We'll quote it, proof it, and make it.
          </p>
          <div class="cta-actions">
            <a href="/quote" class="btn-sticker btn-sticker-paper">Get a Quote</a>
            <a href="mailto:hello@ohsigns.shop" class="btn btn-outline-ink">Email us directly</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────────── */
  .hero { background-color: var(--key); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-label { color: var(--smoke); margin-bottom: 1.25rem; }

  /* Fix 6 — off-register: cyan + magenta only, no yellow plate */
  .off-register {
    text-shadow:
      -2px -2px 0 var(--cyan),
       2px  1px 0 var(--magenta);
  }
  @media (prefers-reduced-motion: reduce) {
    .off-register { text-shadow: none; }
  }

  .hero-heading {
    margin: 0 0 1.5rem;
    color: var(--paper);
    /* Bebas Neue renders all-caps; keep leading tight */
    line-height: 0.9;
  }

  .hero-body {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--smoke);
    max-width: 44ch;
    margin-bottom: 2.25rem;
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Registration marks panel */
  .hero-register-panel {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
  }
  .hrp-inner {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hrp-mark {
    position: absolute;
    opacity: 0.6;
  }
  .hrp-mark-tl { top:    0; left:  0; }
  .hrp-mark-tr { top:    0; right: 0; }
  .hrp-mark-bl { bottom: 0; left:  0; }
  .hrp-mark-br { bottom: 0; right: 0; }

  .hrp-center { text-align: center; }
  .hrp-logo {
    font-family: var(--font-display);
    font-size: 3.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--paper);
  }
  .hrp-bang  { color: var(--yellow); }
  .hrp-sub {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--smoke);
    margin: 0.25rem 0 0;
  }

  @media (max-width: 680px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-register-panel { display: none; }
  }

  /* ── Services strip ───────────────────────────────────────────────────────── */
  .section-header { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-label  { margin-bottom: 0.5rem; }
  .section-header .text-h2 { margin: 0; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 2rem 1.75rem;
    border: 1px solid rgba(10, 10, 10, 0.12);
    color: var(--key);
    transition: border-color var(--duration-base);
  }
  .service-card:hover { border-color: var(--card-color, var(--key)); }

  .service-card-header { display: flex; align-items: center; }
  .service-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .service-card-name  { margin: 0; }
  .service-card-blurb {
    margin: 0;
    font-size: var(--text-sm);
    color: #5c5c5c;
    flex: 1;
    line-height: 1.65;
  }
  .service-card-link {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.04em;
    color: var(--card-color, var(--key));
    margin-top: auto;
  }

  .services-cta { margin-top: 2.5rem; }

  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  /* ── Sample feature ───────────────────────────────────────────────────────── */
  .sample-feature { background-color: var(--key); }
  .sample-feature-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  /* Cut-path card */
  .cut-path-card {
    position: relative;
    flex-shrink: 0;
    width: 200px;
    min-height: 240px;
    border: 2px solid var(--yellow);
    outline: 1px dashed rgba(255, 242, 0, 0.4);
    outline-offset: -10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }
  .cut-path-inner { text-align: center; }
  .cut-path-label {
    color: var(--smoke);
    margin-bottom: 0.5rem;
    display: block;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }
  .cut-path-big {
    font-family: var(--font-display);
    font-size: 4rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--yellow);
    line-height: 1;
    margin: 0 0 0.5rem;
  }
  .cut-path-sub {
    color: var(--smoke);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .sample-feature-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sample-feature-content .text-h2 { margin: 0; }
  .sample-body {
    color: var(--smoke);
    margin: 0;
    max-width: 52ch;
    line-height: 1.7;
  }

  @media (max-width: 680px) {
    .sample-feature-inner { grid-template-columns: 1fr; }
    .cut-path-card { display: none; }
  }

  /* ── Gallery teaser ───────────────────────────────────────────────────────── */
  .gallery-teaser { background-color: var(--paper); color: var(--key); }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .gallery-card { display: block; color: var(--key); }
  .gallery-card-img-wrap {
    position: relative;
    aspect-ratio: 3/2;
    overflow: visible;
    background: rgba(10,10,10,0.08);
  }
  .gallery-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--duration-base);
  }
  .gallery-card:hover .gallery-card-img-wrap img { opacity: 0.88; }
  .gallery-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.55) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    padding: 0.875rem;
  }
  .gallery-card-category {
    color: var(--paper);
    background: rgba(10,10,10,0.7);
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }
  .gallery-card-body { padding: 0.75rem 0 0; }
  .gallery-card-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--key);
  }
  .gallery-cta { margin-top: 2.5rem; }

  @media (max-width: 600px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }

  /* ── How it works ─────────────────────────────────────────────────────────── */
  .how-it-works { background-color: var(--key); }
  .how-it-works .section-header .text-h2 { color: var(--paper); }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .step { display: flex; flex-direction: column; gap: 0.75rem; }
  .step-stage {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--yellow);
    display: block;
  }
  .step-title {
    color: var(--paper);
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .step-body {
    color: var(--smoke);
    font-size: var(--text-sm);
    margin: 0;
    line-height: 1.65;
  }

  @media (max-width: 900px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .steps-grid { grid-template-columns: 1fr; } }

  /* ── CTA band ─────────────────────────────────────────────────────────────── */
  .cta-band { background-color: var(--paper); color: var(--key); }
  .cta-band-inner { padding-block: var(--section-y); }
  .cta-crop-box {
    position: relative;
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid rgba(10,10,10,0.15);
  }
  .cta-content { display: flex; flex-direction: column; gap: 1rem; }
  .cta-heading { margin: 0; color: var(--key); }
  .cta-body { margin: 0; color: #5c5c5c; max-width: 44ch; line-height: 1.7; }
  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.5rem;
  }
</style>

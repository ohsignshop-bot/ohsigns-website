---
import Layout from '../layouts/Layout.astro';
import CropCorners from '../components/CropCorners.astro';
import RegistrationMark from '../components/RegistrationMark.astro';
---

<Layout
  title="About"
  description="OH! Signs is one person in Winston-Salem making die-cut decals, UV prints, and brand design in-house."
  sheet="08/11"
>
  <!-- Hero -->
  <section class="about-hero section-y">
    <div class="container about-hero-inner">
      <div>
        <p class="text-label" style="color: var(--smoke); margin-bottom: 0.75rem;">About</p>
        <h1 class="text-h1 about-title">We're OH! Signs.</h1>
        <p class="about-lead">
          One person. Winston-Salem, NC. Everything designed, printed, and cut in-house — no outsourced production, no vendor chain to call when something goes wrong.
        </p>
      </div>
      <RegistrationMark size={56} color="rgba(245,240,232,0.1)" />
    </div>
  </section>

  <!-- Story -->
  <section class="about-story section-y">
    <div class="container about-story-inner">
      <div class="story-content">
        <p class="text-label story-label">The Short Version</p>
        <p class="story-p">
          OH! Signs is a small-batch sign and print operation. The equipment is here. The files get reviewed here. The vinyl gets cut here. When something needs fixing, it gets fixed here — not forwarded to a third-party production facility three states away.
        </p>
        <p class="story-p">
          That's the whole story. It's not a remarkable founding narrative — it's just a practical choice to own the output from art file to finished piece.
        </p>
        <p class="story-p">
          The work is die-cut vinyl decals and stickers, UV printing on rigid substrates, and design for both. If it's not on that list, ask — but the answer is probably no.
        </p>
      </div>

      <div class="how-we-work">
        <p class="text-label how-label">How We Work</p>
        <dl class="values-list">
          <div class="value-item">
            <dt>Files reviewed before print</dt>
            <dd>Art gets checked before it runs. Better to spend five minutes catching a problem than to reprint an entire order.</dd>
          </div>
          <div class="value-item">
            <dt>Honest turnaround times</dt>
            <dd>You get a realistic estimate. Rush jobs happen — we'll tell you when we can and can't do one.</dd>
          </div>
          <div class="value-item">
            <dt>Quoted price is the price</dt>
            <dd>No hidden fees when the invoice arrives.</dd>
          </div>
          <div class="value-item">
            <dt>No minimum orders</dt>
            <dd>One sticker is a real order. Pricing scales with quantity.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta section-y">
    <div class="container">
      <div class="about-cta-box">
        <CropCorners color="var(--paper)" gap={14} size={16} weight={1} />
        <h2 class="text-h2 about-cta-heading">Ready to start a project?</h2>
        <p class="about-cta-body">Start with a quote request, or email us if you have questions first.</p>
        <div class="about-cta-btns">
          <a href="/quote" class="btn-sticker">Get a Quote</a>
          <a href="mailto:hello@ohsigns.shop" class="about-email-link">hello@ohsigns.shop →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero { background: var(--key); }
  .about-hero-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  .about-title { color: var(--paper); margin: 0 0 1rem; }
  .about-lead {
    color: var(--smoke);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    max-width: 52ch;
    margin: 0;
    line-height: 1.7;
  }

  /* Story */
  .about-story { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .about-story-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .story-label { color: var(--smoke); margin-bottom: 1.25rem; }
  .story-p {
    color: var(--smoke);
    font-size: var(--text-sm);
    line-height: 1.75;
    margin: 0 0 1rem;
    max-width: 52ch;
  }
  .story-p:last-child { margin-bottom: 0; }

  .how-label { color: var(--smoke); margin-bottom: 1.25rem; }
  .values-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .value-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .value-item dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
  }
  .value-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--smoke);
    line-height: 1.6;
  }

  /* CTA */
  .about-cta { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .about-cta-box {
    position: relative;
    padding: clamp(2rem, 5vw, 3rem);
    border: 1px solid rgba(245,240,232,0.1);
    max-width: 560px;
  }
  .about-cta-heading { color: var(--paper); margin: 0 0 0.75rem; }
  .about-cta-body {
    color: var(--smoke);
    margin: 0 0 1.75rem;
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .about-cta-btns {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .about-email-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--smoke);
    transition: color 150ms;
  }
  .about-email-link:hover { color: var(--yellow); }

  @media (max-width: 768px) {
    .about-story-inner { grid-template-columns: 1fr; }
    .about-hero-inner svg { display: none; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import CropCorners from '../components/CropCorners.astro';

const faq = [
  { q: 'Do you have a minimum order?', a: 'No minimum. One sticker, one sign — whatever you need. Pricing just scales with quantity.' },
  { q: 'Can you work with my existing files?', a: "Send us what you have and we'll tell you if it's print-ready. If it needs work, we can fix it — we'll tell you upfront what that costs." },
  { q: 'Do you ship?', a: 'Yes, nationwide. Shipping cost is quoted separately based on order size and destination.' },
  { q: 'How fast can you turn a job around?', a: "Most orders run 3–5 business days from approved art. Rush jobs are possible — ask and we'll tell you honestly whether we can do it." },
  { q: 'Do you do installation?', a: "It depends on the job and your location. Ask us — we'll either handle it or point you to someone reliable." },
];
---

<Layout
  title="Contact"
  description="Get in touch with Oh! Signs — for quotes, questions, and everything in between."
  sheet="09/11"
>
  <!-- Hero -->
  <section class="contact-hero section-y">
    <div class="container">
      <p class="text-label" style="color: var(--smoke); margin-bottom: 0.75rem;">Contact</p>
      <h1 class="text-h1 contact-title">Let's talk.</h1>
      <p class="contact-intro">
        For quotes, use the <a href="/quote" class="contact-inline-link">quote form</a> — it gives us what we need to respond fast.
        For everything else, email works great.
      </p>
    </div>
  </section>

  <!-- Contact info + FAQ -->
  <section class="contact-section section-y">
    <div class="container contact-inner">

      <div class="contact-info">
        <div class="contact-method-box">
          <CropCorners color="var(--cyan)" gap={8} size={12} weight={1} />
          <div class="contact-methods">
            <div class="contact-method">
              <p class="contact-method-label">Email</p>
              <a href="mailto:hello@ohsigns.shop" class="contact-link">hello@ohsigns.shop</a>
              <p class="contact-method-note">Best for questions, proofing, and anything that needs a paper trail.</p>
            </div>

            <div class="contact-method">
              <p class="contact-method-label">Quote Request</p>
              <a href="/quote" class="contact-link">ohsigns.shop/quote</a>
              <p class="contact-method-note">Start here if you know what you need. We respond within one business day — usually faster.</p>
            </div>

            <div class="contact-method">
              <p class="contact-method-label">Response Time</p>
              <p class="contact-method-note" style="margin: 0;">Business days, usually within a few hours during shop hours. Nights and weekends — we're not robots.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-faq">
        <p class="text-label faq-label">Common Questions</p>
        <div class="faq-list">
          {faq.map(({ q, a }) => (
            <details class="faq-item">
              <summary class="faq-q">{q}</summary>
              <p class="faq-a">{a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .contact-hero { background: var(--key); }
  .contact-title { color: var(--paper); margin: 0 0 1rem; }
  .contact-intro {
    color: var(--smoke);
    max-width: 52ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .contact-inline-link { color: var(--yellow); transition: opacity 150ms; }
  .contact-inline-link:hover { opacity: 0.8; }

  /* Contact section */
  .contact-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-method-box {
    position: relative;
    padding: 2rem;
    border: 1px solid rgba(245,240,232,0.1);
  }
  .contact-methods { display: flex; flex-direction: column; gap: 1.75rem; }
  .contact-method { display: flex; flex-direction: column; gap: 0.375rem; }
  .contact-method-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke);
    margin: 0;
  }
  .contact-link {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(245,240,232,0.2);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms;
  }
  .contact-link:hover { text-decoration-color: var(--yellow); }
  .contact-method-note { margin: 0; font-size: var(--text-sm); color: var(--smoke); line-height: 1.6; }

  /* FAQ */
  .faq-label { color: var(--smoke); margin-bottom: 1.25rem; }
  .faq-list { display: flex; flex-direction: column; }
  .faq-item {
    border-bottom: 1px solid rgba(245,240,232,0.08);
  }
  .faq-item:first-child { border-top: 1px solid rgba(245,240,232,0.08); }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: var(--text-sm);
    color: var(--paper);
    cursor: pointer;
    list-style: none;
    user-select: none;
    line-height: 1.4;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--yellow);
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 150ms;
  }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }
  .faq-a { margin: 0 0 1rem; font-size: var(--text-sm); color: var(--smoke); line-height: 1.65; }

  @media (max-width: 768px) { .contact-inner { grid-template-columns: 1fr; } }
</style>

---
import Layout from '../../layouts/Layout.astro';
import CropCorners from '../../components/CropCorners.astro';
import { getCollection } from 'astro:content';

const allWork = (await getCollection('work'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = ['all', ...Array.from(new Set(allWork.map((e) => e.data.category)))];
---

<Layout
  title="Our Work"
  description="A portfolio of recent decals, UV prints, and brand design from Oh! Signs in Winston-Salem."
  sheet="06/11"
>
  <!-- Hero -->
  <section class="page-hero section-y">
    <div class="container">
      <p class="text-label" style="color: var(--smoke);">Portfolio</p>
      <h1 class="text-h1 portfolio-title">Our Work.</h1>
      <p class="portfolio-intro">
        Recent projects across die-cut decals, UV printing, and brand design.
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="gallery section-y">
    <div class="container">
      <!-- Category filter -->
      <div class="filter-bar" role="group" aria-label="Filter by category">
        {categories.map((cat) => (
          <button
            class="filter-btn"
            data-category={cat}
            aria-pressed={cat === 'all' ? 'true' : 'false'}
          >
            {cat === 'all' ? 'All' : cat.replace('-', ' ')}
          </button>
        ))}
      </div>

      <div class="work-grid" id="work-grid">
        {allWork.map((entry) => (
          <div class="work-card" data-category={entry.data.category}>
            <div class="work-card-img-wrap">
              <CropCorners color="var(--paper)" gap={6} size={10} weight={1} />
              <div class="work-card-img">
                <img
                  src={entry.data.image}
                  alt={entry.data.imageAlt}
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="work-card-body">
              <span class="work-card-cat">{entry.data.category.replace('-', ' ')}</span>
              <h2 class="work-card-title">{entry.data.title}</h2>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="work-cta-section section-y">
    <div class="container">
      <p class="text-label" style="color: var(--smoke); margin-bottom: 0.75rem;">Next Step</p>
      <h2 class="text-h2 work-cta-heading">Ready to start a project?</h2>
      <div class="work-cta-actions">
        <a href="/quote" class="btn-sticker">Get a Quote</a>
        <a href="/sample-pack" class="work-secondary-link">Request Sample Pack →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: var(--key); }
  .portfolio-title { color: var(--paper); margin: 0.5rem 0 0.75rem; }
  .portfolio-intro { color: var(--smoke); max-width: 52ch; margin: 0; font-size: var(--text-sm); line-height: 1.7; }

  .gallery { background: var(--key); }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgba(245,240,232,0.15);
    background: transparent;
    color: var(--smoke);
    cursor: pointer;
    transition: background 150ms, color 150ms, border-color 150ms;
    border-radius: 0;
  }
  .filter-btn:hover,
  .filter-btn[aria-pressed="true"] {
    background: var(--paper);
    color: var(--key);
    border-color: var(--paper);
  }

  /* Work grid */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .work-card { display: flex; flex-direction: column; gap: 0.875rem; }
  .work-card[hidden] { display: none; }

  .work-card-img-wrap {
    position: relative;
    overflow: visible;
  }
  .work-card-img {
    aspect-ratio: 3/2;
    overflow: hidden;
    background: rgba(245,240,232,0.04);
  }
  .work-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--ease-out-expo);
    display: block;
  }
  .work-card:hover .work-card-img img { transform: scale(1.04); }

  .work-card-body { padding: 0 0.25rem; }
  .work-card-cat {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke);
    margin-bottom: 0.375rem;
  }
  .work-card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
    line-height: 1.15;
  }

  /* CTA */
  .work-cta-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .work-cta-heading { color: var(--paper); margin: 0 0 1.5rem; }
  .work-cta-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .work-secondary-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--smoke);
    transition: color 150ms;
  }
  .work-secondary-link:hover { color: var(--paper); }

  @media (max-width: 900px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px)  { .work-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards   = document.querySelectorAll<HTMLDivElement>('.work-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      cards.forEach((card) => {
        card.hidden = !(cat === 'all' || card.dataset.category === cat);
      });
    });
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import CropCorners from '../../components/CropCorners.astro';
import RegistrationMark from '../../components/RegistrationMark.astro';

const services = [
  {
    href: '/services/decals',
    label: 'DECALS & STICKERS',
    color: 'var(--cyan)',
    code: 'C',
    desc: 'Die-cut vinyl, printed stickers, wall decals. Any shape, any size, no minimum.',
    cta: 'See decal options →',
  },
  {
    href: '/services/uv',
    label: 'UV HARD GOODS',
    color: 'var(--magenta)',
    code: 'M',
    desc: 'Flat-bed UV directly onto acrylic, metal, wood, PVC foam board, and more. Scratch-resistant, edge-to-edge.',
    cta: 'See UV options →',
  },
  {
    href: '/services/design',
    label: 'DESIGN SERVICES',
    color: 'var(--yellow)',
    code: 'Y',
    desc: 'Logo, brand identity, signage layout, and production-ready file prep. Art that goes to press looking right.',
    cta: 'See design options →',
  },
];
---

<Layout
  title="Services"
  description="Die-cut vinyl decals, UV printing on rigid substrates, and brand design — made in-house at Oh! Signs."
  sheet="02/11"
>
  <!-- Hero -->
  <section class="services-hero section-y">
    <div class="container services-hero-inner">
      <div>
        <p class="text-label" style="color: var(--smoke);">What We Make</p>
        <h1 class="text-h1 services-headline">What We Do.</h1>
        <p class="services-intro">
          Three capabilities. Everything in-house. No mystery vendors, no three-week gaps while your job floats across a supply chain.
        </p>
      </div>
      <RegistrationMark size={48} color="rgba(245,240,232,0.12)" />
    </div>
  </section>

  <!-- Service cards -->
  <section class="services-cards-section section-y">
    <div class="container">
      <div class="services-grid">
        {services.map(({ href, label, color, code, desc, cta }) => (
          <a href={href} class="svc-card">
            <div class="svc-card-inner">
              <CropCorners color={color} gap={10} size={14} weight={1} />
              <div class="svc-chip" style={`background: ${color}; color: var(--key);`}>{code}</div>
              <h2 class="svc-name" style={`color: ${color};`}>{label}</h2>
              <p class="svc-desc">{desc}</p>
              <span class="svc-cta" style={`color: ${color};`}>{cta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="services-cta-section section-y">
    <div class="container">
      <div class="services-cta-box">
        <CropCorners color="var(--paper)" gap={14} size={16} weight={1} />
        <p class="text-label" style="color: var(--smoke);">Start Here</p>
        <h2 class="text-h2 services-cta-headline">Not sure what you need?</h2>
        <p class="services-cta-body">Tell us what you're trying to accomplish. We'll figure out the right approach.</p>
        <div class="services-cta-btns">
          <a href="/quote" class="btn-sticker">Get a Quote</a>
          <a href="/contact" class="services-link">Ask a question →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hero {
    background: var(--key);
  }
  .services-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .services-headline {
    color: var(--paper);
    margin: 0.5rem 0 1rem;
  }
  .services-intro {
    color: var(--smoke);
    max-width: 52ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* Service cards */
  .services-cards-section { background: var(--key); }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .svc-card {
    display: block;
    color: var(--paper);
    text-decoration: none;
    transition: transform 200ms;
  }
  .svc-card:hover { transform: translateY(-2px); }
  .svc-card-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid rgba(245,240,232,0.1);
    height: 100%;
    box-sizing: border-box;
  }

  .svc-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .svc-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }
  .svc-desc {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--smoke);
    margin: 0;
    line-height: 1.65;
  }
  .svc-cta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Bottom CTA */
  .services-cta-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .services-cta-box {
    position: relative;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid rgba(245,240,232,0.1);
    max-width: 680px;
  }
  .services-cta-headline {
    color: var(--paper);
    margin: 0.5rem 0 0.75rem;
  }
  .services-cta-body {
    color: var(--smoke);
    margin: 0 0 1.75rem;
    font-size: var(--text-sm);
    max-width: 44ch;
    line-height: 1.65;
  }
  .services-cta-btns {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .services-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--smoke);
    transition: color 150ms;
  }
  .services-link:hover { color: var(--paper); }

  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; }
    .services-hero-inner svg { display: none; }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import CropCorners from '../../components/CropCorners.astro';

const offerings = [
  { name: 'Logo Design', body: "Original mark or wordmark delivered in all standard formats (AI, EPS, SVG, PNG). Includes a one-page usage guide so the logo stays consistent." },
  { name: 'Brand Identity', body: "Logo plus colour system, type pairing, and basic brand guidelines. Scoped to fit small businesses through full commercial rollouts." },
  { name: 'Signage Layout', body: "Take your logo and copy and design a sign that works at scale. We know what reads from ten feet and what disappears." },
  { name: 'File Prep &amp; Cleanup', body: "Already have a logo but it's a low-res JPG from 2009? We vectorise, clean up, and prep it for production. Flat fee, fast turn." },
  { name: 'Retouching &amp; Modifications', body: "Add a year, swap a tagline, adjust a colour. Small revisions handled quickly without charging for a whole new design." },
];

const steps = [
  { n: '01', title: 'Brief', body: "Tell us what the business does, who it's for, and what feeling you're going for. The more detail, the better the first round." },
  { n: '02', title: 'Concepts', body: "We deliver initial concepts. Logo projects typically include 2–3 directions — you pick one to develop." },
  { n: '03', title: 'Revisions', body: "Two rounds of revisions included. Additional rounds at an hourly rate. Most projects wrap in two." },
  { n: '04', title: 'Final Files', body: "Production-ready files delivered in all formats — and we'll answer questions about how to use them going forward." },
];
---

<Layout
  title="Design Services"
  description="Logo design, brand identity, signage layout, and file prep from Oh! Signs — art that goes to press looking right."
  sheet="05/11"
>
  <!-- Hero -->
  <section class="page-hero section-y">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/services">Services</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">Design Services</span>
      </nav>
      <h1 class="text-h1 page-title">Design Services.</h1>
      <p class="page-intro">
        Great printing starts with great art. We do original design, brand systems, and production-ready file prep — so nothing goes to press looking wrong.
      </p>
      <div class="hero-actions">
        <a href="/quote" class="btn-sticker">Get a Design Quote</a>
      </div>
    </div>
  </section>

  <!-- Offerings -->
  <section class="offerings-section section-y">
    <div class="container">
      <p class="text-label offerings-label">What We Offer</p>
      <div class="offerings-grid">
        {offerings.map(({ name, body }) => (
          <div class="offering-card">
            <h2 class="offering-name" set:html={name} />
            <p class="offering-body" set:html={body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section section-y">
    <div class="container process-inner">
      <div class="process-box">
        <CropCorners color="var(--yellow)" gap={12} size={14} weight={1} />
        <p class="text-label process-label">The Process</p>
        <div class="process-steps">
          {steps.map(({ n, title, body }) => (
            <div class="process-step">
              <span class="step-num">{n}</span>
              <div>
                <h3 class="step-title">{title}</h3>
                <p class="step-body">{body}</p>
              </div>
            </div>
          ))}
        </div>
        <a href="/quote" class="btn-sticker" style="margin-top: 2rem; display: inline-flex;">Start a Design Project</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: var(--key); }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--smoke);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--smoke); transition: color 150ms; }
  .breadcrumb a:hover { color: var(--paper); }
  .breadcrumb span[aria-current] { color: var(--yellow); }

  .page-title { color: var(--paper); margin: 0 0 1rem; }
  .page-intro {
    color: var(--smoke);
    max-width: 54ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .hero-actions { margin-top: 1.75rem; }

  /* Offerings */
  .offerings-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .offerings-label { color: var(--smoke); margin-bottom: 1.75rem; }
  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .offering-card {
    padding: 1.5rem;
    border: 1px solid rgba(245,240,232,0.1);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .offering-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
  }
  .offering-body { margin: 0; font-size: var(--text-sm); color: var(--smoke); line-height: 1.65; }

  /* Process */
  .process-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .process-inner { max-width: 680px; }
  .process-box {
    position: relative;
    padding: 2.5rem;
    border: 1px solid rgba(245,240,232,0.1);
  }
  .process-label { color: var(--smoke); margin-bottom: 1.75rem; }
  .process-steps { display: flex; flex-direction: column; gap: 1.5rem; }
  .process-step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--yellow);
    background: rgba(255,242,0,0.08);
    border: 1px solid rgba(255,242,0,0.2);
    padding: 0.25rem 0.5rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .step-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0 0 0.25rem;
  }
  .step-body { margin: 0; font-size: var(--text-sm); color: var(--smoke); line-height: 1.6; }

  @media (max-width: 768px) { .offerings-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .offerings-grid { grid-template-columns: 1fr; } }
</style>

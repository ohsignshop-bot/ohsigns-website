---
import Layout from '../../layouts/Layout.astro';

const substrates = [
  'Acrylic (clear, white, frosted)',
  'Aluminium composite (Dibond)',
  'Aluminium sheet',
  'PVC foam board',
  'Wood (sealed)',
  'Glass (non-tempered)',
  'Rigid PVC',
  'Ceramic tile',
  'Leather & faux leather',
  'Powder-coated metal',
];
---

<Layout
  title="UV Printing"
  description="Flat-bed UV printing onto acrylic, metal, wood, foam board, and more. Made in-house at Oh! Signs."
>
  <section class="page-hero section-y">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/services">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">UV Printing</span>
      </nav>
      <h1 class="text-h1" style="color: var(--color-cream); margin: 1rem 0;">UV Printing.</h1>
      <p class="page-hero-body">
        Flat-bed UV curing means the ink bonds directly to the substrate — no wrap, no laminate required.
        The result is scratch-resistant, fade-resistant, and exactly as sharp as the file you send us.
      </p>
      <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/quote" class="btn btn-primary">Get a UV Quote</a>
        <a href="/sample-pack" class="btn btn-outline">Free Sample Pack</a>
      </div>
    </div>
  </section>

  <section class="uv-why section-cream section-y">
    <div class="container uv-why-inner">
      <div>
        <h2 class="text-h2" style="margin-bottom: 1.5rem;">Why UV printing.</h2>
        <div class="why-list">
          <div class="why-item">
            <h3 class="text-h3">Prints on almost anything</h3>
            <p>If it's flat and fits on the bed, we can print on it. Bring us your weird idea — we probably can.</p>
          </div>
          <div class="why-item">
            <h3 class="text-h3">No laminate required</h3>
            <p>UV-cured ink is already hard. For most indoor applications you don't need a protective overlay.</p>
          </div>
          <div class="why-item">
            <h3 class="text-h3">White ink capable</h3>
            <p>Print white on dark or clear substrates. Essential for backlit acrylic and coloured materials.</p>
          </div>
          <div class="why-item">
            <h3 class="text-h3">Edge-to-edge coverage</h3>
            <p>We can print to within a couple millimetres of the substrate edge. No white border unless you want one.</p>
          </div>
        </div>
      </div>
      <div class="substrate-column">
        <h3 class="text-h3" style="margin-bottom: 1rem;">Substrates we work with</h3>
        <ul class="substrate-list" role="list">
          {substrates.map((s) => <li>{s}</li>)}
        </ul>
        <p style="font-size: var(--text-sm); color: #5a6050; margin-top: 1rem;">
          Don't see your material? Ask us — we test new substrates regularly.
        </p>
      </div>
    </div>
  </section>

  <section class="spec-section section-y">
    <div class="container">
      <h2 class="text-h2" style="color: var(--color-cream); margin-bottom: 1.5rem;">File specs.</h2>
      <dl class="spec-list">
        <dt>Preferred format</dt>
        <dd>Print-ready PDF, AI, or layered PSD at 300 dpi. Include crop marks for bordered jobs.</dd>
        <dt>Colour mode</dt>
        <dd>CMYK. We can convert from RGB — ask if you need a proof first.</dd>
        <dt>Max print area</dt>
        <dd>Varies by substrate size. Contact us for oversized quotes.</dd>
        <dt>Lead time</dt>
        <dd>2–4 business days standard. Same-day rush available for simple jobs.</dd>
      </dl>
      <a href="/quote" class="btn btn-primary" style="margin-top: 2rem;">Start a UV Quote</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background-color: var(--color-ink); }
  .page-hero-body { color: var(--color-smoke); max-width: 54ch; margin: 0; }

  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-size: var(--text-sm); color: var(--color-smoke); }
  .breadcrumb a { color: var(--color-smoke); transition: color var(--duration-fast); }
  .breadcrumb a:hover { color: var(--color-cream); }
  .breadcrumb span[aria-current] { color: var(--color-cream); }

  .uv-why { background-color: var(--color-cream); color: var(--color-ink); }
  .uv-why-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }
  .why-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .why-item { display: flex; flex-direction: column; gap: 0.375rem; }
  .why-item h3 { margin: 0; }
  .why-item p  { margin: 0; font-size: var(--text-sm); color: #5a6050; }

  .substrate-column { display: flex; flex-direction: column; }
  .substrate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .substrate-list li {
    font-size: var(--text-sm);
    padding: 0.375rem 0;
    border-bottom: 1px solid rgba(14,15,12,0.08);
    color: #5a6050;
  }
  .substrate-list li::before { content: '— '; color: var(--color-blood); }

  .spec-section { background-color: var(--color-ink); color: var(--color-cream); }
  .spec-list { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.5rem; margin: 0; max-width: 640px; }
  .spec-list dt { font-weight: 600; font-size: var(--text-sm); white-space: nowrap; }
  .spec-list dd { margin: 0; font-size: var(--text-sm); color: var(--color-smoke); }

  @media (max-width: 768px) {
    .uv-why-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>

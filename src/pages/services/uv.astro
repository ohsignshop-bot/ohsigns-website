---
import Layout from '../../layouts/Layout.astro';
import CropCorners from '../../components/CropCorners.astro';

const substrates = [
  'Acrylic — clear, white, frosted',
  'Aluminium composite (Dibond)',
  'Aluminium sheet',
  'PVC foam board',
  'Wood — sealed',
  'Glass — non-tempered',
  'Rigid PVC',
  'Ceramic tile',
  'Leather and faux leather',
  'Powder-coated metal',
];

const reasons = [
  { heading: 'Prints on almost anything', body: "If it's flat and fits on the bed, we can print on it. Bring the weird idea — we probably can." },
  { heading: 'No laminate required', body: "UV-cured ink is already hard. For most indoor applications you don't need a protective overlay." },
  { heading: 'White ink capable', body: "Print white on dark or clear substrates. Essential for backlit acrylic and anything where white needs to pop." },
  { heading: 'Edge-to-edge coverage', body: "We can print within a couple millimetres of the edge. No white border unless you want one." },
];
---

<Layout
  title="UV Printing"
  description="Flat-bed UV printing onto acrylic, metal, wood, foam board, and more. Made in-house at Oh! Signs."
  sheet="04/11"
>
  <!-- Hero -->
  <section class="page-hero section-y">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/services">Services</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">UV Printing</span>
      </nav>
      <h1 class="text-h1 page-title">UV Printing.</h1>
      <p class="page-intro">
        Flat-bed UV curing means ink bonds directly to the substrate — no wrap, no laminate required.
        Scratch-resistant, fade-resistant, as sharp as the file you send.
      </p>
      <div class="hero-actions">
        <a href="/quote" class="btn-sticker">Get a UV Quote</a>
        <a href="/sample-pack" class="hero-secondary-link">Free Sample Pack →</a>
      </div>
    </div>
  </section>

  <!-- Why UV -->
  <section class="uv-why section-y">
    <div class="container uv-why-inner">
      <div class="uv-reasons">
        <p class="text-label reasons-label">Why UV</p>
        <div class="reasons-grid">
          {reasons.map(({ heading, body }) => (
            <div class="reason-item">
              <h2 class="reason-heading">{heading}</h2>
              <p class="reason-body">{body}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="substrate-col">
        <div class="substrate-box">
          <CropCorners color="var(--magenta)" gap={8} size={12} weight={1} />
          <p class="text-label substrate-label">Substrates</p>
          <ul class="substrate-list" role="list">
            {substrates.map((s) => <li>{s}</li>)}
          </ul>
          <p class="substrate-note">Don't see your material? Ask — we test new substrates regularly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs -->
  <section class="spec-section section-y">
    <div class="container spec-inner">
      <div>
        <p class="text-label spec-label">File Specs</p>
        <h2 class="text-h2 spec-heading">What to send us.</h2>
        <dl class="spec-list">
          <dt>Preferred format</dt>
          <dd>Print-ready PDF, AI, or layered PSD at 300 dpi. Include crop marks for bordered jobs.</dd>
          <dt>Colour mode</dt>
          <dd>CMYK. We can convert from RGB — ask if you need a proof first.</dd>
          <dt>Max print area</dt>
          <dd>Varies by substrate. Contact us for oversized quotes.</dd>
          <dt>Lead time</dt>
          <dd>2–4 business days standard. Same-day rush available for simple jobs — ask.</dd>
        </dl>
      </div>
      <div class="spec-cta-col">
        <a href="/quote" class="btn-sticker">Start a UV Quote</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { background: var(--key); }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--smoke);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--smoke); transition: color 150ms; }
  .breadcrumb a:hover { color: var(--paper); }
  .breadcrumb span[aria-current] { color: var(--magenta); }

  .page-title { color: var(--paper); margin: 0 0 1rem; }
  .page-intro {
    color: var(--smoke);
    max-width: 54ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
  .hero-secondary-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--smoke);
    transition: color 150ms;
  }
  .hero-secondary-link:hover { color: var(--paper); }

  /* Why UV */
  .uv-why { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .uv-why-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }
  .reasons-label { color: var(--smoke); margin-bottom: 1.5rem; }
  .reasons-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .reason-item { display: flex; flex-direction: column; gap: 0.375rem; }
  .reason-heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
  }
  .reason-body { margin: 0; font-size: var(--text-sm); color: var(--smoke); line-height: 1.6; }

  .substrate-col { padding-top: 1.5rem; }
  .substrate-box {
    position: relative;
    padding: 1.5rem;
    border: 1px solid rgba(245,240,232,0.1);
  }
  .substrate-label { color: var(--smoke); margin-bottom: 1rem; }
  .substrate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .substrate-list li {
    font-size: var(--text-sm);
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(245,240,232,0.06);
    color: var(--smoke);
    line-height: 1.4;
  }
  .substrate-list li::before { content: '— '; color: var(--magenta); }
  .substrate-note {
    margin: 0.875rem 0 0;
    font-size: 0.75rem;
    color: rgba(122,122,122,0.6);
    line-height: 1.5;
  }

  /* Specs */
  .spec-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .spec-label { color: var(--smoke); margin-bottom: 0.75rem; }
  .spec-heading { color: var(--paper); margin: 0 0 1.5rem; }
  .spec-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: start;
  }
  .spec-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0;
    max-width: 640px;
  }
  .spec-list dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--magenta);
    white-space: nowrap;
    padding-top: 0.125rem;
  }
  .spec-list dd { margin: 0; font-size: var(--text-sm); color: var(--smoke); line-height: 1.6; }
  .spec-cta-col { padding-top: 3rem; }

  @media (max-width: 900px) { .uv-why-inner { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .reasons-grid  { grid-template-columns: 1fr; }
    .spec-inner    { grid-template-columns: 1fr; gap: 2rem; }
    .spec-cta-col  { padding-top: 0; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm/index.tsx';
import CropCorners from '../components/CropCorners.astro';
import '../components/QuoteForm/styles.css';

const bmsUrl = import.meta.env.PUBLIC_BMS_REQUEST_URL || 'https://bms.ohsigns.shop/api/public/requests';
---

<Layout
  title="Get a Quote"
  description="Request a quote for die-cut decals, UV-printed hard goods, or design services from Oh! Signs."
>
  <!-- Hero -->
  <section class="quote-hero section-y">
    <div class="container quote-hero-inner">
      <div class="quote-hero-content">
        <p class="text-label" style="color: var(--smoke); margin-bottom: 0.75rem;">Get a Quote</p>
        <h1 class="text-h1 quote-title">Tell us what you need.</h1>
        <p class="quote-intro">
          Fill out the form — we'll review and respond within one business day.
          The more detail, the faster we can turn it around.
        </p>
      </div>

      <!-- Tips panel with crop marks -->
      <div class="quote-tips-wrap" aria-hidden="true">
        <div class="quote-tips-box">
          <CropCorners color="var(--paper)" gap={10} size={12} weight={1} />
          <ul class="tips-list" role="list">
            <li>
              <span class="tip-bullet" aria-hidden="true">—</span>
              <span>Dimensions help quote accurately: width × height in inches.</span>
            </li>
            <li>
              <span class="tip-bullet" aria-hidden="true">—</span>
              <span>Quantity matters for pricing — even a rough number helps.</span>
            </li>
            <li>
              <span class="tip-bullet" aria-hidden="true">—</span>
              <span>Attach artwork if you have it. AI, EPS, or PDF preferred.</span>
            </li>
            <li>
              <span class="tip-bullet" aria-hidden="true">—</span>
              <span>No artwork yet? Describe what you're going for.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Form section -->
  <section class="quote-form-section section-y">
    <div class="container">
      <div class="quote-form-wrap">
        <QuoteForm client:load mode="quote" bmsUrl={bmsUrl} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .quote-hero {
    background-color: var(--key);
    padding-bottom: 0;
  }
  .quote-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .quote-title {
    color: var(--paper);
    margin: 0 0 1rem;
  }
  .quote-intro {
    color: var(--smoke);
    max-width: 48ch;
    margin: 0;
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  /* Tips panel */
  .quote-tips-wrap {
    flex-shrink: 0;
    color: var(--paper);
  }
  .quote-tips-box {
    position: relative;
    width: 280px;
    padding: 1.5rem;
    border: 1px solid rgba(245, 240, 232, 0.1);
  }
  .tips-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .tips-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-sm);
    color: var(--smoke);
    line-height: 1.55;
  }
  .tip-bullet {
    color: var(--yellow);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    margin-top: 0.125rem;
  }

  /* Form section — dark background, form styles already match */
  .quote-form-section { background-color: var(--key); }
  .quote-form-wrap { max-width: 680px; }

  @media (max-width: 768px) {
    .quote-hero-inner { grid-template-columns: 1fr; }
    .quote-tips-wrap  { display: none; }
  }
</style>

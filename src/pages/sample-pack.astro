---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm/index.tsx';
import CropCorners from '../components/CropCorners.astro';
import '../components/QuoteForm/styles.css';

const bmsUrl = import.meta.env.PUBLIC_BMS_REQUEST_URL || 'https://bms.ohsigns.shop/api/public/requests';

const whatsInside = [
  'Die-cut vinyl decal on cast material',
  'Die-cut printed sticker with gloss laminate',
  'Die-cut printed sticker with matte laminate',
  'Die-cut printed sticker on kraft stock',
  'UV-printed acrylic tile',
  'UV-printed PVC foam board tile',
  'UV-printed Dibond aluminium tile',
];
---

<Layout
  title="Free Sample Pack"
  description="Request a free 4x5.25in rigid mailer with seven finished printed pieces from Oh! Signs."
  sheet="07/11"
>
  <!-- Hero -->
  <section class="sample-hero section-y">
    <div class="container sample-hero-inner">
      <div class="sample-hero-content">
        <p class="text-label" style="color: var(--smoke); margin-bottom: 0.75rem;">Free</p>
        <h1 class="text-h1 sample-title">Sample Pack.</h1>
        <p class="sample-intro">
          A 4×5.25" rigid mailer with seven finished printed pieces — real production output, not swatches.
          See and feel exactly what we make before you order anything.
        </p>
        <a href="#sample-form" class="btn-sticker" style="margin-top: 1.75rem;">Request Yours Free</a>
      </div>

      <!-- Packing-slip badge -->
      <div class="sample-badge-wrap" aria-hidden="true">
        <div class="sample-badge">
          <CropCorners color="var(--yellow)" gap={8} size={12} weight={1.5} />
          <div class="badge-inner">
            <p class="badge-label">OH! SIGNS</p>
            <p class="badge-big">SAMPLE<br/>PACK</p>
            <p class="badge-sub">7 pieces</p>
            <p class="badge-sub">4×5.25" mailer</p>
            <div class="badge-stamp">FREE</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's inside -->
  <section class="contents-section section-y">
    <div class="container">
      <p class="text-label contents-label">Contents — 7 pieces</p>
      <ol class="contents-list">
        {whatsInside.map((item, i) => (
          <li class="contents-item">
            <span class="contents-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="contents-text">{item}</span>
          </li>
        ))}
      </ol>
      <p class="contents-note">
        Every piece is production output — cut, printed, and finished the same way your order would be.
        No mock-ups, no display samples.
      </p>
    </div>
  </section>

  <!-- Form -->
  <section id="sample-form" class="sample-form-section section-y">
    <div class="container">
      <div class="sample-form-wrap">
        <div class="sample-form-box">
          <CropCorners color="var(--paper)" gap={12} size={16} weight={1} />
          <p class="text-label form-label">Request Your Pack</p>
          <p class="form-note">No obligation, no sales call. Just materials shipped to your door.</p>
          <QuoteForm client:load mode="sample" bmsUrl={bmsUrl} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .sample-hero { background: var(--key); }
  .sample-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .sample-title { color: var(--paper); margin: 0 0 1rem; }
  .sample-intro {
    color: var(--smoke);
    max-width: 48ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* Packing-slip badge */
  .sample-badge-wrap { flex-shrink: 0; }
  .sample-badge {
    position: relative;
    width: 200px;
  }
  .badge-inner {
    padding: 1.5rem;
    border: 1px solid rgba(245,240,232,0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }
  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--smoke);
    margin: 0;
  }
  .badge-big {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0.25rem 0;
  }
  .badge-sub {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--smoke);
    margin: 0;
  }
  .badge-stamp {
    margin-top: 0.875rem;
    padding: 0.25rem 1rem;
    border: 2px solid var(--yellow);
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    transform: rotate(-4deg);
  }

  /* Contents */
  .contents-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .contents-label { color: var(--smoke); margin-bottom: 1.5rem; }
  .contents-list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    max-width: 560px;
    display: flex;
    flex-direction: column;
  }
  .contents-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.625rem 0;
    border-bottom: 1px solid rgba(245,240,232,0.06);
  }
  .contents-num {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--yellow);
    flex-shrink: 0;
    min-width: 1.5rem;
  }
  .contents-text {
    font-size: var(--text-sm);
    color: var(--smoke);
    line-height: 1.5;
  }
  .contents-note {
    margin: 0;
    font-size: 0.75rem;
    color: rgba(122,122,122,0.6);
    max-width: 52ch;
    line-height: 1.6;
  }

  /* Form */
  .sample-form-section { background: var(--key); border-top: 1px solid rgba(245,240,232,0.06); }
  .sample-form-wrap { max-width: 640px; }
  .sample-form-box {
    position: relative;
    padding: 2.5rem;
    border: 1px solid rgba(245,240,232,0.1);
  }
  .form-label { color: var(--smoke); margin-bottom: 0.5rem; }
  .form-note {
    font-size: var(--text-sm);
    color: var(--smoke);
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .sample-hero-inner { grid-template-columns: 1fr; }
    .sample-badge-wrap { display: none; }
  }
</style>

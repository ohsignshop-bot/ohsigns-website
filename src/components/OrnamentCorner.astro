---
/**
 * Art Nouveau / tattoo-flash corner flourish.
 * Inherits currentColor — place inside a colored container and it adapts.
 *
 * Usage:
 *   <OrnamentCorner />                     → top-left
 *   <OrnamentCorner rotation={90} />       → top-right
 *   <OrnamentCorner rotation={180} />      → bottom-right
 *   <OrnamentCorner rotation={270} />      → bottom-left
 *
 * The SVG is 72×72. Corner rules extend to the far edge of the viewBox
 * so they can be clipped or overlapped by sibling elements.
 */
interface Props {
  rotation?: 0 | 90 | 180 | 270;
  size?: number;
  class?: string;
}
const { rotation = 0, size = 72, class: cls = '' } = Astro.props;
const transform = rotation ? `rotate(${rotation} 36 36)` : undefined;
---

<svg
  viewBox="0 0 72 72"
  width={size}
  height={size}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={cls}
>
  <g transform={transform}>
    <!-- ── Frame rules: heavy outer + thin inner ────────────────────────── -->
    <!-- Horizontal rule along top edge -->
    <line x1="22" y1="5"  x2="72" y2="5"  stroke="currentColor" stroke-width="1.5"/>
    <!-- Vertical rule along left edge -->
    <line x1="5"  y1="22" x2="5"  y2="72" stroke="currentColor" stroke-width="1.5"/>
    <!-- Inner thin parallel, horizontal -->
    <line x1="26" y1="11" x2="72" y2="11" stroke="currentColor" stroke-width="0.75"/>
    <!-- Inner thin parallel, vertical -->
    <line x1="11" y1="26" x2="11" y2="72" stroke="currentColor" stroke-width="0.75"/>

    <!-- ── Corner arc: connects the two outer rules ─────────────────────── -->
    <!-- Outer arc — same weight as rules -->
    <path d="M 22 5 Q 5 5 5 22" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <!-- Inner arc — lighter -->
    <path d="M 26 11 Q 11 11 11 26" stroke="currentColor" stroke-width="0.75" fill="none"/>

    <!-- ── Botanical flourish ────────────────────────────────────────────── -->
    <!-- Primary leaf: upper-right, pointing outward -->
    <path
      d="M 16 16 C 22 8 34 12 30 22 C 24 16 16 16 16 16 Z"
      stroke="currentColor" stroke-width="1" stroke-linejoin="round"
      fill="currentColor" fill-opacity="0.18"
    />
    <!-- Secondary leaf: lower-left, pointing inward -->
    <path
      d="M 16 16 C 8 22 12 34 22 30 C 16 24 16 16 16 16 Z"
      stroke="currentColor" stroke-width="1" stroke-linejoin="round"
      fill="currentColor" fill-opacity="0.18"
    />
    <!-- Stem from junction to outer corner -->
    <path
      d="M 16 16 C 12 12 8 8 5.5 5.5"
      stroke="currentColor" stroke-width="0.75" stroke-linecap="round"
    />
    <!-- Leaf cluster center dot -->
    <circle cx="16" cy="16" r="2" fill="currentColor"/>

    <!-- ── Terminal decorations on rule ends ────────────────────────────── -->
    <!-- Short tick at horizontal rule end -->
    <line x1="72" y1="2" x2="72" y2="8" stroke="currentColor" stroke-width="1.5"/>
    <!-- Short tick at vertical rule end -->
    <line x1="2" y1="72" x2="8" y2="72" stroke="currentColor" stroke-width="1.5"/>

    <!-- Small diamond at rule mid-points (optional accent) -->
    <rect
      x="37" y="3" width="4" height="4"
      transform="rotate(45 39 5)"
      fill="currentColor" fill-opacity="0.6"
    />
    <rect
      x="3" y="37" width="4" height="4"
      transform="rotate(45 5 39)"
      fill="currentColor" fill-opacity="0.6"
    />
  </g>
</svg>

---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/work',     label: 'Work' },
  { href: '/about',    label: 'About' },
  { href: '/contact',  label: 'Contact' },
];

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header" role="banner">
  <div class="container header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="Oh! Signs — home">
      <span class="logo-oh">Oh</span><span class="logo-bang">!</span><span class="logo-signs"> Signs</span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label="Main navigation">
      <ul role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={isActive(href) ? 'nav-link nav-link--active' : 'nav-link'}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/quote" class="btn-sticker header-cta">Get a Quote</a>

      <!-- Mobile menu toggle -->
      <button
        class="nav-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <line x1="2" y1="5.5"  x2="20" y2="5.5"  stroke="currentColor" stroke-width="1.5"/>
          <line x1="2" y1="11"   x2="20" y2="11"   stroke="currentColor" stroke-width="1.5"/>
          <line x1="2" y1="16.5" x2="20" y2="16.5" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="nav-mobile" aria-label="Mobile navigation" hidden>
    <ul role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={isActive(href) ? 'nav-link nav-link--active' : 'nav-link'}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href="/quote" class="btn-sticker nav-mobile-cta">Get a Quote</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--key);
    border-bottom: 1px solid rgba(245, 240, 232, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 4rem;
  }

  /* Logo */
  .logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    flex-shrink: 0;
  }
  .logo-oh    { color: var(--paper); }
  .logo-bang  { color: var(--yellow); }
  .logo-signs { color: var(--paper); }

  /* Desktop nav */
  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--smoke);
    transition: color var(--duration-fast);
  }
  .nav-link:hover { color: var(--paper); }
  .nav-link--active { color: var(--yellow); }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Header CTA — compact sticker button */
  .header-cta {
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }
  /* Override the ::after inset for the small header button */
  .header-cta::after {
    inset: 3px;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--paper);
    cursor: pointer;
    padding: 0.25rem;
  }
  .nav-toggle:hover { color: var(--yellow); }

  /* Mobile menu */
  .nav-mobile {
    border-top: 1px solid rgba(245, 240, 232, 0.06);
    padding: 1rem 0 1.5rem;
    background-color: var(--key);
  }
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0 var(--container-x);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-mobile .nav-link {
    padding: 0.625rem 0;
    font-size: var(--text-sm);
  }
  .nav-mobile-cta {
    margin-top: 1rem;
    display: block;
    text-align: center;
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .nav-desktop { display: none; }
    .nav-toggle  { display: flex; }
    .header-actions .header-cta { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const menu   = document.getElementById('mobile-menu') as HTMLElement | null;

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hidden === false;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
  });
</script>

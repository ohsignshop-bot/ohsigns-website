---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/work',     label: 'Work' },
  { href: '/about',    label: 'About' },
  { href: '/contact',  label: 'Contact' },
];

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="Oh! Signs — home">
      <span class="logo-oh">Oh</span><span class="logo-bang">!</span><span class="logo-signs"> Signs</span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" aria-label="Main navigation">
      <ul role="list">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={isActive(href) ? 'nav-link nav-link--active' : 'nav-link'}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/quote" class="btn btn-primary">Get a Quote</a>

      <!-- Mobile menu toggle -->
      <button
        class="nav-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"  stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="3" y1="18" x2="21" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="nav-mobile" aria-label="Mobile navigation" hidden>
    <ul role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={isActive(href) ? 'nav-link nav-link--active' : 'nav-link'}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
      <li><a href="/quote" class="btn btn-primary nav-mobile-cta">Get a Quote</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-ink);
    border-bottom: 1px solid rgba(242, 234, 216, 0.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 4rem;
  }

  /* Logo */
  .logo {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    line-height: 1;
    flex-shrink: 0;
  }
  .logo-oh     { color: var(--color-cream); }
  .logo-bang   { color: var(--color-acid); }
  .logo-signs  { color: var(--color-cream); }

  /* Desktop nav */
  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.375rem 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-smoke);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast), background-color var(--duration-fast);
  }
  .nav-link:hover {
    color: var(--color-cream);
    background-color: rgba(242, 234, 216, 0.06);
  }
  .nav-link--active {
    color: var(--color-cream);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-cream);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
  }
  .nav-toggle:hover { color: var(--color-acid); }

  /* Mobile menu */
  .nav-mobile {
    border-top: 1px solid rgba(242, 234, 216, 0.08);
    padding: 1rem 0 1.5rem;
  }
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0 var(--container-x);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-mobile .nav-link {
    padding: 0.625rem 0.75rem;
    font-size: 1rem;
  }
  .nav-mobile-cta {
    margin-top: 0.75rem;
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .nav-desktop { display: none; }
    .nav-toggle  { display: flex; }
    .header-actions .btn-primary { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const menu   = document.getElementById('mobile-menu') as HTMLElement | null;

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hidden === false;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
  });
</script>

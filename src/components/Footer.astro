---
const year = new Date().getFullYear();

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/work',     label: 'Our Work' },
  { href: '/about',    label: 'About' },
  { href: '/contact',  label: 'Contact' },
  { href: '/quote',    label: 'Get a Quote' },
];

const services = [
  { href: '/services/decals', label: 'Decals & Stickers' },
  { href: '/services/uv',     label: 'UV Printing' },
  { href: '/services/design', label: 'Design Services' },
  { href: '/sample-pack',     label: 'Free Sample Pack' },
];

const EMAIL = 'hello@ohsigns.shop';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">

    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Oh! Signs — home">
        <span class="logo-oh">Oh</span><span class="logo-bang">!</span><span class="logo-signs"> Signs</span>
      </a>
      <p class="footer-tagline">We're serious about the work,<br/>not ourselves.</p>
      <div class="footer-social" aria-label="Social media">
        <!-- Placeholder social links — swap hrefs when real accounts exist -->
        <a href="#" class="social-link" aria-label="Instagram" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
          </svg>
        </a>
        <a href="#" class="social-link" aria-label="Facebook" rel="noopener noreferrer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-nav-group">
        <h3 class="footer-nav-heading">Navigate</h3>
        <ul role="list">
          {navLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-nav-group">
        <h3 class="footer-nav-heading">Services</h3>
        <ul role="list">
          {services.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-nav-group">
        <h3 class="footer-nav-heading">Get in Touch</h3>
        <ul role="list">
          <li>
            <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </li>
          <li>
            <a href="/quote" class="footer-cta-link">Start a project &rarr;</a>
          </li>
        </ul>
      </div>
    </nav>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-legal">
        &copy; {year} OH! Signs LLC. All rights reserved.
      </p>
      <p class="footer-legal">
        Made with craft, not magic.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #080809;
    border-top: 1px solid rgba(242, 234, 216, 0.08);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  /* Brand column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .logo-oh    { color: var(--color-cream); }
  .logo-bang  { color: var(--color-acid); }
  .logo-signs { color: var(--color-cream); }

  .footer-tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-smoke);
    line-height: 1.6;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(242, 234, 216, 0.15);
    border-radius: var(--radius-sm);
    color: var(--color-smoke);
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .social-link:hover {
    color: var(--color-cream);
    border-color: rgba(242, 234, 216, 0.4);
  }

  /* Nav columns */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-nav-group h3 {
    margin: 0 0 1rem;
  }
  .footer-nav-heading {
    font-family: var(--font-display);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .footer-nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-nav-group a {
    font-size: var(--text-sm);
    color: var(--color-smoke);
    transition: color var(--duration-fast);
  }
  .footer-nav-group a:hover { color: var(--color-cream); }
  .footer-cta-link { color: var(--color-acid) !important; font-weight: 600; }
  .footer-cta-link:hover { color: var(--color-cream) !important; }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(242, 234, 216, 0.06);
    padding-block: 1.25rem;
  }
  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-legal {
    margin: 0;
    font-size: var(--text-label);
    color: rgba(138, 144, 128, 0.6);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-nav   { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .footer-nav { grid-template-columns: 1fr 1fr; }
    .footer-nav-group:last-child { grid-column: span 2; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
